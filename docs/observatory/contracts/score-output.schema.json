{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://toslop.com/schemas/observatory/score-output.v1.json",
  "title": "Observatory Score Output",
  "description": "Proposed structural contract for one versioned observatory score result. Scorer-specific arithmetic consistency is enforced by the pinned semantic validator defined in ES-001.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "study_release_id",
    "score_id",
    "score_name",
    "entity",
    "topic",
    "source_frame",
    "period",
    "evidence_class",
    "release_state",
    "score",
    "confidence",
    "uncertainty_interval",
    "sample",
    "coverage",
    "baseline",
    "current_value",
    "change",
    "trend",
    "components",
    "warnings",
    "suppression",
    "lineage",
    "versions",
    "calculated_at",
    "links"
  ],
  "properties": {
    "schema_version": {
      "const": "observatory.score_output.v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "study_release_id": {
      "type": ["string", "null"],
      "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
    },
    "score_id": {
      "enum": ["S1", "S2", "S3", "S4", "S5", "S6", "S7", "S8"]
    },
    "score_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "entity": {
      "$ref": "#/$defs/dimension"
    },
    "topic": {
      "oneOf": [
        {
          "$ref": "#/$defs/dimension"
        },
        {
          "type": "null"
        }
      ]
    },
    "source_frame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "source_family_count", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "source_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "granularity", "start", "end"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        },
        "granularity": {
          "enum": ["week", "month", "quarter", "year", "study"]
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "evidence_class": {
      "enum": ["descriptive", "exposure_association", "causal_estimate"]
    },
    "release_state": {
      "enum": ["experimental", "validated", "production", "retired"]
    },
    "score": {
      "type": ["number", "null"],
      "minimum": 0,
      "maximum": 100
    },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "method", "calibration_version"],
      "properties": {
        "value": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "calibration_version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "uncertainty_interval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lower", "upper", "level", "method"],
      "properties": {
        "lower": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "upper": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "level": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "method": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "replicates": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "cluster_unit": {
          "type": ["string", "null"],
          "maxLength": 80
        }
      }
    },
    "sample": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size", "effective_size", "unit"],
      "properties": {
        "size": {
          "type": "integer",
          "minimum": 0
        },
        "effective_size": {
          "type": ["number", "null"],
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "coverage": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "eligible_rate",
        "matched_rate",
        "entity_count",
        "source_count",
        "source_family_count",
        "complete"
      ],
      "properties": {
        "eligible_rate": {
          "$ref": "#/$defs/rate"
        },
        "matched_rate": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 1
        },
        "entity_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_count": {
          "type": "integer",
          "minimum": 0
        },
        "source_family_count": {
          "type": "integer",
          "minimum": 0
        },
        "complete": {
          "type": "boolean"
        },
        "dimensions": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "start", "end", "value", "complete", "version"],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "start": {
          "type": "string",
          "format": "date"
        },
        "end": {
          "type": "string",
          "format": "date"
        },
        "value": {
          "type": ["number", "null"]
        },
        "complete": {
          "type": "boolean"
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "current_value": {
      "type": ["number", "null"]
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["absolute", "relative"],
      "properties": {
        "absolute": {
          "type": ["number", "null"]
        },
        "relative": {
          "type": ["number", "null"]
        }
      }
    },
    "trend": {
      "enum": ["increasing", "decreasing", "stable", "insufficient", "not_applicable"]
    },
    "components": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/component"
      }
    },
    "warnings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reasons"],
      "properties": {
        "status": {
          "enum": ["released", "suppressed"]
        },
        "reasons": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
          }
        }
      }
    },
    "lineage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["data_snapshot_ids", "run_id", "manifest_sha256"],
      "properties": {
        "data_snapshot_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          }
        },
        "run_id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$"
        },
        "manifest_sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "versions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scorer",
        "feature_pipeline",
        "corpus",
        "benchmark",
        "ontology",
        "score_registry",
        "warning_registry",
        "release_registry"
      ],
      "properties": {
        "scorer": {
          "$ref": "#/$defs/semver"
        },
        "feature_pipeline": {
          "$ref": "#/$defs/semver"
        },
        "corpus": {
          "$ref": "#/$defs/semver"
        },
        "benchmark": {
          "$ref": "#/$defs/semver"
        },
        "ontology": {
          "$ref": "#/$defs/semver"
        },
        "score_registry": {
          "$ref": "#/$defs/semver"
        },
        "warning_registry": {
          "$ref": "#/$defs/semver"
        },
        "release_registry": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "calculated_at": {
      "type": "string",
      "format": "date-time"
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methodology", "benchmark", "release"],
      "properties": {
        "methodology": {
          "$ref": "#/$defs/pathOrUrl"
        },
        "benchmark": {
          "$ref": "#/$defs/pathOrUrl"
        },
        "release": {
          "$ref": "#/$defs/pathOrUrl"
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "properties": {
          "suppression": {
            "type": "object",
            "properties": {
              "status": {
                "const": "suppressed"
              }
            },
            "required": ["status"]
          }
        }
      },
      "then": {
        "type": "object",
        "properties": {
          "score": {
            "type": "null"
          },
          "confidence": {
            "type": "object",
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "uncertainty_interval": {
            "type": "object",
            "properties": {
              "lower": {
                "type": "null"
              },
              "upper": {
                "type": "null"
              }
            }
          },
          "baseline": {
            "type": "object",
            "properties": {
              "value": {
                "type": "null"
              }
            }
          },
          "current_value": {
            "type": "null"
          },
          "change": {
            "type": "object",
            "properties": {
              "absolute": {
                "type": "null"
              },
              "relative": {
                "type": "null"
              }
            }
          },
          "components": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "raw_value": {
                  "type": "null"
                },
                "normalized_value": {
                  "type": "null"
                },
                "status": {
                  "enum": ["missing", "suppressed"]
                }
              }
            }
          },
          "trend": {
            "const": "insufficient"
          },
          "suppression": {
            "type": "object",
            "properties": {
              "reasons": {
                "type": "array",
                "minItems": 1
              }
            }
          }
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number"
          },
          "confidence": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              }
            }
          },
          "uncertainty_interval": {
            "type": "object",
            "properties": {
              "lower": {
                "type": "number"
              },
              "upper": {
                "type": "number"
              }
            }
          },
          "coverage": {
            "type": "object",
            "properties": {
              "complete": {
                "const": true
              }
            }
          },
          "baseline": {
            "type": "object",
            "properties": {
              "value": {
                "type": "number"
              },
              "complete": {
                "const": true
              }
            }
          },
          "current_value": {
            "type": "number"
          },
          "change": {
            "type": "object",
            "properties": {
              "absolute": {
                "type": "number"
              }
            }
          },
          "components": {
            "type": "object",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "raw_value": {
                  "type": "number"
                },
                "normalized_value": {
                  "type": "number"
                },
                "status": {
                  "enum": ["available", "degraded"]
                }
              }
            }
          },
          "suppression": {
            "type": "object",
            "properties": {
              "reasons": {
                "type": "array",
                "maxItems": 0
              }
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "dimension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "label", "version"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-zA-Z0-9][a-zA-Z0-9._:-]{0,159}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "version": {
          "$ref": "#/$defs/semver"
        }
      }
    },
    "component": {
      "type": "object",
      "additionalProperties": false,
      "required": ["raw_value", "normalized_value", "weight", "unit", "status"],
      "properties": {
        "raw_value": {
          "type": ["number", "null"]
        },
        "normalized_value": {
          "type": ["number", "null"],
          "minimum": 0,
          "maximum": 100
        },
        "weight": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "status": {
          "enum": ["available", "degraded", "missing", "suppressed"]
        }
      },
      "allOf": [
        {
          "if": {
            "type": "object",
            "properties": {
              "status": {
                "enum": ["missing", "suppressed"]
              }
            },
            "required": ["status"]
          },
          "then": {
            "type": "object",
            "properties": {
              "raw_value": {
                "type": "null"
              },
              "normalized_value": {
                "type": "null"
              }
            }
          },
          "else": {
            "type": "object",
            "properties": {
              "raw_value": {
                "type": "number"
              },
              "normalized_value": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "warning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "severity", "message"],
      "properties": {
        "code": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_]{1,63}$"
        },
        "severity": {
          "enum": ["info", "warning", "error"]
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "details": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "integer", "boolean", "null"]
          }
        }
      }
    },
    "rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z.-]+)?$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "pathOrUrl": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    }
  }
}
