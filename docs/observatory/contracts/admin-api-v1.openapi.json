{
  "openapi": "3.1.0",
  "info": {
    "title": "Toslop Observatory Specification Admin API",
    "version": "1.0.0",
    "description": "Read, validate, and propose reviewed changes to bounded observatory specification files."
  },
  "servers": [
    {
      "url": "https://admin.toslop.com"
    }
  ],
  "security": [
    {
      "basicAuth": []
    },
    {
      "accessAssertion": []
    }
  ],
  "paths": {
    "/api/admin/session": {
      "get": {
        "operationId": "getAdminSession",
        "responses": {
          "200": {
            "description": "Authenticated session and repository boundary.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/sessionResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/$defs/errorResponseComponent"
          }
        }
      }
    },
    "/api/admin/specs": {
      "get": {
        "operationId": "listAdminSpecs",
        "responses": {
          "200": {
            "description": "Allowed specification files at the configured base reference.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/specListResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/$defs/errorResponseComponent"
          }
        }
      }
    },
    "/api/admin/spec": {
      "get": {
        "operationId": "getAdminSpec",
        "parameters": [
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "$ref": "#/$defs/specPath"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "One UTF-8 Markdown or JSON specification file.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/specResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/$defs/errorResponseComponent"
          }
        }
      }
    },
    "/api/admin/validate": {
      "post": {
        "operationId": "validateAdminSpec",
        "parameters": [
          {
            "$ref": "#/$defs/originHeader"
          },
          {
            "$ref": "#/$defs/fetchSiteHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/$defs/specContentRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Deterministic syntax and structure validation result.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/validationResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/$defs/errorResponseComponent"
          }
        }
      }
    },
    "/api/admin/proposals": {
      "post": {
        "operationId": "createAdminSpecProposal",
        "parameters": [
          {
            "$ref": "#/$defs/originHeader"
          },
          {
            "$ref": "#/$defs/fetchSiteHeader"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/$defs/proposalRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Branch, one-file commit, and pull request created.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/$defs/proposalResponse"
                }
              }
            }
          },
          "default": {
            "$ref": "#/$defs/errorResponseComponent"
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Temporary tunnel deployment authentication."
      },
      "accessAssertion": {
        "type": "apiKey",
        "in": "header",
        "name": "Cf-Access-Jwt-Assertion",
        "description": "Cloudflare Access assertion validated by the admin Worker."
      }
    }
  },
  "$defs": {
    "originHeader": {
      "name": "Origin",
      "in": "header",
      "required": true,
      "schema": {
        "type": "string",
        "format": "uri"
      },
      "description": "Must exactly equal the request origin."
    },
    "fetchSiteHeader": {
      "name": "Sec-Fetch-Site",
      "in": "header",
      "required": false,
      "schema": {
        "type": "string",
        "const": "same-origin"
      },
      "description": "When present, must be same-origin."
    },
    "specPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512,
      "pattern": "^docs/observatory/(?:[^/]+/)*(?:[^/]+\\.md|[^/]+\\.json)$"
    },
    "gitSha": {
      "type": "string",
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "severity",
        "code",
        "message"
      ],
      "properties": {
        "severity": {
          "type": "string",
          "enum": [
            "error",
            "warning"
          ]
        },
        "code": {
          "type": "string",
          "pattern": "^[a-z0-9_]+$"
        },
        "message": {
          "type": "string"
        }
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "valid",
        "kind",
        "size",
        "findings"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "valid": {
          "type": "boolean"
        },
        "kind": {
          "type": "string",
          "enum": [
            "intent",
            "execution",
            "json",
            "documentation"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256000
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        }
      }
    },
    "sessionResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "session"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "session": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "email",
            "mode",
            "repository",
            "reference",
            "root",
            "can_propose"
          ],
          "properties": {
            "email": {
              "type": "string"
            },
            "mode": {
              "type": "string",
              "enum": [
                "access",
                "basic",
                "local"
              ]
            },
            "repository": {
              "type": "string"
            },
            "reference": {
              "type": "string"
            },
            "root": {
              "type": "string"
            },
            "can_propose": {
              "type": "boolean"
            }
          }
        }
      }
    },
    "specListResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "files",
        "base_sha",
        "truncated"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "path",
              "name",
              "size",
              "sha"
            ],
            "properties": {
              "path": {
                "$ref": "#/$defs/specPath"
              },
              "name": {
                "type": "string"
              },
              "size": {
                "type": "integer",
                "minimum": 0
              },
              "sha": {
                "type": "string"
              }
            }
          }
        },
        "base_sha": {
          "type": "string"
        },
        "truncated": {
          "const": false
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "name",
        "sha",
        "size",
        "html_url",
        "content"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/specPath"
        },
        "name": {
          "type": "string"
        },
        "sha": {
          "type": "string"
        },
        "size": {
          "type": "integer",
          "minimum": 0,
          "maximum": 256000
        },
        "html_url": {
          "type": "string"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "specResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "spec"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "spec": {
          "$ref": "#/$defs/spec"
        }
      }
    },
    "specContentRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/specPath"
        },
        "content": {
          "type": "string"
        }
      }
    },
    "validationResponse": {
      "$ref": "#/$defs/validation"
    },
    "proposalRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "content",
        "expected_sha",
        "title",
        "summary"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/specPath"
        },
        "content": {
          "type": "string"
        },
        "expected_sha": {
          "$ref": "#/$defs/gitSha"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      }
    },
    "proposalResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "proposal",
        "validation"
      ],
      "properties": {
        "ok": {
          "const": true
        },
        "proposal": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "number",
            "url",
            "branch",
            "sha"
          ],
          "properties": {
            "number": {
              "type": "integer",
              "minimum": 1
            },
            "url": {
              "type": "string"
            },
            "branch": {
              "type": "string",
              "pattern": "^admin/"
            },
            "sha": {
              "type": "string"
            }
          }
        },
        "validation": {
          "$ref": "#/$defs/validation"
        }
      }
    },
    "errorResponse": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ok",
        "error"
      ],
      "properties": {
        "ok": {
          "const": false
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "code",
            "message"
          ],
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^[a-z0-9_]+$"
            },
            "message": {
              "type": "string"
            },
            "details": {}
          }
        }
      }
    },
    "errorResponseComponent": {
      "description": "Bounded error response.",
      "content": {
        "application/json": {
          "schema": {
            "$ref": "#/$defs/errorResponse"
          }
        }
      }
    }
  }
}
